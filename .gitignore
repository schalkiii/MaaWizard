# 前端
node_modules/
dist/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# 运行时 SDK（make fetch-sdk 下载，体积大且为第三方产物）
maa-sdk/

# 本地工作数据（memory 目录纳入版本管理，其余忽略）
.codebuddy/*
!.codebuddy/memory/
*.log

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 截图临时文件
resource/.screenshot.png

# 内嵌编辑器（MaaPipelineEditor）离线资源
# 由 tools/MaaPipelineEditor 源码构建生成，属衍生产物，不入库；重建：make mpe
public/mpe/

# npm install 生成的锁文件（上游用 yarn.lock），避免误提交污染 subtree
tools/MaaPipelineEditor/Editor/package-lock.json

# dev 期 Rust cwd 为 src-tauri，截图等运行时产物会落到 src-tauri/resource/
# （仓库根的 resource/ 才是正式资源目录，由 resolve_existing_path() 回溯命中）
src-tauri/resource/
